# Application
APP_ENV=development
PORT=:8080

# Database
DATABASE_URL=postgres://genki:genki_dev_password@localhost:5432/genki?sslmode=disable

# Security
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars

# Database Monitor Encryption Key (optional but strongly recommended)
# Required when using the "Database" monitor type — connection strings are
# encrypted at rest using AES-256-GCM with this key.
# Generate with: openssl rand -hex 32
# Leave empty to disable encryption (plaintext storage — not recommended for production).
# DB_ENCRYPTION_KEY=your-64-hex-char-key-here

# Password Reset (optional)
# Set a strong secret here to enable the /forgot-password feature.
# Users must enter this value to reset their password.
# Leave empty to disable password reset.
# RESET_SECRET=change-this-to-a-strong-reset-secret

# Optional
# POSTGRES_PASSWORD=genki  # used by docker-compose (default: genki)
